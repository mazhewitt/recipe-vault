# Production Environment Variables

# Your Docker Hub username (used for the image name)
DOCKERHUB_USERNAME=your_dockerhub_username_here

# API Key for Claude/OpenAI
ANTHROPIC_API_KEY=your_anthropic_key_here
# OR
# OPENAI_API_KEY=your_openai_key_here

# Family password for web access
FAMILY_PASSWORD=your_secure_password_here

# Optional: Database URL (default is sqlite:///app/data/recipes.db)
# DATABASE_URL=sqlite:///app/data/recipes.db

# Optional: Port (default is 3000)
# PORT=3000

# Optional: AI provider and models
# Anthropic defaults: AI_MODEL=claude-sonnet-4-6, DIFFICULTY_MODEL=claude-haiku-4-5
# Gemini defaults:    AI_MODEL=gemini-3.8-flash, DIFFICULTY_MODEL=gemini-3.5-flash-lite
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# AI_MODEL=gemini-3.8-flash
# DIFFICULTY_MODEL=gemini-3.5-flash-lite
# Rollback to the previous Gemini chat model: AI_MODEL=gemini-2.5-pro

# Optional, Gemini only: output budget incl. thinking (default 16384)
# GEMINI_MAX_OUTPUT_TOKENS=16384
# Optional, Gemini 3+ only: low | medium | high (unset = model default)
# GEMINI_THINKING_LEVEL=low

# Web search is enabled automatically (uses DuckDuckGo via uvx, no API key required)
# "find me a recipe for X" searches in the native language of the dish's cuisine
